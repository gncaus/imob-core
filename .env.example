# Copie para .env na raiz do repositório: cp .env.example .env
# Os valores abaixo batem com o docker-compose.yml.

# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta HTTP da API
API_PORT=3333

# Nível de log do pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Conexão com o PostgreSQL
DATABASE_URL=postgresql://imob:imob@localhost:5432/imob?schema=public
