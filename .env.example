# Copie para .env na raiz do repositório: cp .env.example .env
# Os valores abaixo batem com o docker-compose.yml.

# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta HTTP da API
API_PORT=3333

# Nível de log do pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Porta do PostgreSQL exposta pelo docker compose (troque se a 5432 já estiver em uso)
POSTGRES_PORT=5432

# Conexão com o PostgreSQL (a porta deve bater com POSTGRES_PORT)
DATABASE_URL=postgresql://imob:imob@localhost:5432/imob?schema=public

# Banco usado pelos testes e2e (criado e migrado automaticamente pelo pnpm test).
# Se omitido, usa o DATABASE_URL trocando o nome do banco por imob_test.
TEST_DATABASE_URL=postgresql://imob:imob@localhost:5432/imob_test?schema=public

# Segredo para assinar o JWT da sessão (mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-48-bytes

# Duração da sessão em segundos (padrão: 8 horas)
SESSION_TTL_SECONDS=28800

# Cookie de sessão com flag Secure. Se omitido, liga só com NODE_ENV=production.
# COOKIE_SECURE=true

# Tentativas de login por IP a cada minuto
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Usuário admin criado pelo pnpm db:seed
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@imob.local
SEED_ADMIN_PASSWORD=admin12345

# Armazenamento de fotos compatível com S3 (MinIO do docker compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=imob
S3_SECRET_KEY=imob-secret
# Bucket criado automaticamente pela API, com leitura pública
S3_BUCKET=imob-photos
# URL pública das fotos, usada no painel e no feed (em produção, o domínio público ou CDN)
PHOTOS_PUBLIC_BASE_URL=http://localhost:9000/imob-photos
